<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BmwebFlasher"
        x:Class="BmwebFlasher.MainWindow"
        Width="880" Height="720" MinWidth="780" MinHeight="640"
        Icon="/Assets/icon.ico"
        Title="BMWeb Flasher">
  <!-- Laid out like MS4X Flasher: a rail of screens down the left, the
       control unit and Identify across the top, the screen in the middle, a
       log of what happened below it, and the status line with the progress
       bar at the bottom. Skinned like BMWeb (Styles/Flasher.axaml). Every
       control keeps its name: the code-behind addresses them. -->
  <Grid ColumnDefinitions="54,*" RowDefinitions="Auto,*,Auto">

    <!-- ============ rail ============ -->
    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Classes="bar" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6" Margin="7,10,7,0">
          <Image Source="avares://BmwebFlasher/Assets/logo-512.png" Width="26" Height="26" Margin="0,0,0,10"/>
          <Button x:Name="RailFlashing" Classes="rail current" Content="&#x21AF;" Click="RailFlashing_Click"
                  ToolTip.Tip="Flashing"/>
          <Button x:Name="RailFaults" Classes="rail" Content="&#x26A0;&#xFE0E;" Click="RailFaults_Click"
                  IsEnabled="{Binding #FaultsTab.IsEnabled}" ToolTip.Tip="Fault Codes"/>
          <Button x:Name="RailLive" Classes="rail" Content="&#x223F;" Click="RailLive_Click"
                  IsEnabled="{Binding #LiveTab.IsEnabled}" ToolTip.Tip="Live Log"/>
          <Button x:Name="RailHistory" Classes="rail" Content="&#x27F2;" Click="RailHistory_Click"
                  ToolTip.Tip="History"/>
          <Button x:Name="RailEmulator" Classes="rail" Content="&#x25A3;" Click="RailEmulator_Click"
                  ToolTip.Tip="Emulator"/>
          <Button x:Name="RailSettings" Classes="rail" Content="&#x2699;&#xFE0E;" Click="RailSettings_Click"
                  ToolTip.Tip="Settings"/>
        </StackPanel>
        <TextBlock x:Name="BrandVersion" Grid.Row="2" Classes="mono faint" FontSize="9"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
      </Grid>
    </Border>

    <!-- ============ top bar ============ -->
    <Border Grid.Column="1" Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Padding="14,10">
      <StackPanel Spacing="8">
      <!-- Shown for as long as the app is connected to an emulator: nothing
           it does then reaches a car, and nobody should have to wonder. -->
      <Border x:Name="EmulatorBanner" Classes="emulator" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock x:Name="EmulatorBannerText" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button x:Name="EmulatorBannerCable" Grid.Column="1" Content="Back to the cable" Classes="key"
                  Click="EmulatorUseCable_Click"
                  ToolTip.Tip="Connect the app to the cable again. The emulator keeps running."/>
        </Grid>
      </Border>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <!-- Choose the module first; the DME and TCU controls are shown
             exclusively so their buttons can never be confused. -->
        <ComboBox x:Name="FlashModuleSelect" Grid.Column="0" MinWidth="180"
                  PlaceholderText="Control unit..."
                  SelectionChanged="FlashModuleSelect_Changed">
          <ComboBoxItem Content="DME (engine)"/>
          <ComboBoxItem Content="TCU (transmission)"/>
        </ComboBox>
        <Border Grid.Column="1" Classes="ecu">
          <TextBlock x:Name="EcuName_Box" Classes="mono" FontWeight="Medium" HorizontalAlignment="Center"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Select a control unit"/>
        </Border>
        <Button x:Name="IdentifyDME" Grid.Column="2" Content="Identify ECU" Classes="primary"
                MinWidth="120" Click="IdentifyDME_Click" IsEnabled="False"/>
      </Grid>
      </StackPanel>
    </Border>

    <!-- ============ screen ============ -->
    <TabControl x:Name="MainTabs" Grid.Column="1" Grid.Row="1" Classes="rail" Margin="14,12,14,0"
                SelectionChanged="MainTabs_SelectionChanged">

      <!-- ============ Flashing ============ -->
      <TabItem Header="Flashing">
        <!-- Two views share this screen. Custom Options replaces the flashing
             controls rather than getting a screen of its own. -->
        <Panel>
        <Grid x:Name="FlashingMainView" ColumnDefinitions="*,236" ColumnSpacing="14">

          <!-- the log, like MS4X Flasher's: every status line as it came -->
          <Border Grid.Column="0" Classes="log">
            <ScrollViewer x:Name="StatusLogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="StatusLog" Classes="mono" TextWrapping="Wrap" LineHeight="19"/>
            </ScrollViewer>
          </Border>

          <!-- The identification the code fills in. It is summarised in the
               ECU box at the top; the fields themselves are kept out of sight. -->
          <StackPanel Grid.Column="0" IsVisible="False">
            <TextBlock x:Name="ModuleInfoHeader"/>
            <TextBlock x:Name="DMEType_Box"/>
            <TextBlock x:Name="HWRef_Box"/>
            <TextBlock x:Name="SWRef_Box"/>
            <TextBlock x:Name="VIN_Box"/>
            <TextBlock x:Name="progRef_Box"/>
            <TextBlock x:Name="programStatus_Box"/>
            <TextBlock x:Name="diagProtocol_Box"/>
          </StackPanel>

          <!-- The actions; Custom Options is pinned to the bottom of the
               column. The stack scrolls if the window is ever shorter than it. -->
          <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="5">
              <Button x:Name="SetPort"      Content="Set Serial Port"        HorizontalAlignment="Stretch" Click="SetPort_Click"/>
              <Button x:Name="LoadSGBD"     Content="Load SGBD (.PRG)"       HorizontalAlignment="Stretch" Click="LoadSGBD_Click"/>

              <!-- DME controls -->
              <StackPanel x:Name="DmePanel" Spacing="5">
                <Button x:Name="ReadTune"     Content="Read DME"               HorizontalAlignment="Stretch" Click="ReadTune_Click"     IsEnabled="False"/>
                <!-- Only for a car that identified as carrying the map switch. -->
                <Button x:Name="ReadInstalledMaps" Content="Read Installed Maps" HorizontalAlignment="Stretch" Click="ReadInstalledMaps_Click" IsVisible="False"
                        ToolTip.Tip="Reads map 1 and map 2 from the car and saves each as a tune file."/>
                <Button x:Name="LoadFile"     Content="Load File / .0da"       HorizontalAlignment="Stretch" Click="LoadFile_Click"     IsEnabled="False"/>
                <TextBlock x:Name="LoadFileName_Box" IsVisible="False" Classes="mono faint"
                           TextTrimming="CharacterEllipsis" Margin="2,-2,0,2"/>
                <!-- Shown when a BMW .0PA / .0DA was loaded in place of a raw
                     binary. It sits under the button it was loaded with,
                     which is greyed out until it is removed. -->
                <Border x:Name="ExchangeFileRow" IsVisible="False" Classes="pill">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ExchangeFile_Box" Grid.Column="0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ExchangeFileRemove" Grid.Column="1" Content="&#x2715;" Classes="key"
                            Padding="6,1" Margin="4,0,0,0" Click="ExchangeFileRemove_Click"
                            ToolTip.Tip="Remove the loaded file."/>
                  </Grid>
                </Border>
                <!-- File 2 and Flash Program only mean something for a full
                     binary, so they stay hidden until Full Binary is ticked. -->
                <Button x:Name="LoadFile2"    Content="Load File 2 (MPC Flash)" HorizontalAlignment="Stretch" Click="LoadFile2_Click"    IsEnabled="False" IsVisible="False"/>
                <TextBlock x:Name="LoadFile2Name_Box" IsVisible="False" Classes="mono faint"
                           TextTrimming="CharacterEllipsis" Margin="2,-2,0,2"/>
                <!-- The .0DA paired with a loaded .0PA, which has no tune of
                     its own. Optional: without it the tune on the car stays. -->
                <Border x:Name="ExchangeTuneRow" IsVisible="False" Classes="pill">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ExchangeTune_Box" Grid.Column="0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ExchangeTuneRemove" Grid.Column="1" Content="&#x2715;" Classes="key"
                            Padding="6,1" Margin="4,0,0,0" Click="ExchangeTuneRemove_Click"
                            ToolTip.Tip="Remove the tune. The tune on the car is then left as it is."/>
                  </Grid>
                </Border>
                <Button x:Name="FlashProgram" Content="Flash Program" Classes="danger" HorizontalAlignment="Stretch" Click="FlashProgram_Click" IsEnabled="False" IsVisible="False"/>
                <Button x:Name="FlashDME"     Content="Flash Tune"    Classes="danger" HorizontalAlignment="Stretch" Click="FlashData_Click"    IsEnabled="False"/>
                <CheckBox x:Name="FullBin_CheckBox" Content="Full Binary" IsEnabled="False" Click="FullBin_CheckBox_Changed"/>
              </StackPanel>

              <!-- TCU controls. The GS20 SGBD has no flash jobs, so this is
                   read-only: a calibration dump for backup/inspection. -->
              <StackPanel x:Name="TcuPanel" Spacing="5" IsVisible="False">
                <Button x:Name="ReadTcuCal" Content="Read Calibration" HorizontalAlignment="Stretch"
                        Click="ReadTcuCal_Click" IsEnabled="False"
                        ToolTip.Tip="Dump the transmission calibration (0x090000, 64 KB) to a file."/>
                <Button x:Name="LoadTcuCal" Content="Load Calibration File" HorizontalAlignment="Stretch"
                        Click="LoadTcuCal_Click" IsEnabled="False"
                        ToolTip.Tip="Pick a 64 KB GS20 calibration to write. Its checksum is corrected automatically."/>
                <TextBlock x:Name="TcuCalName_Box" IsVisible="False" Classes="mono faint"
                           TextTrimming="CharacterEllipsis" Margin="2,-2,0,2"/>
                <!-- Like the DME: the tune (calibration) is the everyday
                     write; the program only appears behind Full Binary. -->
                <Button x:Name="WriteTcuCal" Content="Write Calibration" Classes="danger" HorizontalAlignment="Stretch"
                        Click="WriteTcuCal_Click" IsEnabled="False"
                        ToolTip.Tip="Erase and reprogram the transmission calibration over raw DS2."/>
                <!-- Program write. The one path here whose failure is not
                     recoverable over the diagnostic port: the DS2 handler
                     lives in the region being rewritten, so a module left
                     half-written stops answering and needs the boot-strap
                     loader. Gated on ident, on the image's software level,
                     and on an explicit acknowledgement. -->
                <Button x:Name="LoadTcuProgram" Content="Load Program File" HorizontalAlignment="Stretch"
                        Click="LoadTcuProgram_Click" IsEnabled="False" IsVisible="False"
                        ToolTip.Tip="A 256 KB program region, a 512 KB full image, or a BMW .0PA. Its checksum is corrected on the way in."/>
                <TextBlock x:Name="TcuProgramName_Box" IsVisible="False" Classes="mono faint"
                           TextTrimming="CharacterEllipsis" Margin="2,-2,0,2"/>
                <!-- The calibration written straight after the program. A
                     program of another release than the transmission runs
                     needs one (the module reports a program/data mismatch
                     and does not run until it has it); otherwise it is
                     optional, like the DME's .0DA next to a .0PA. -->
                <Border x:Name="TcuProgramTuneRow" IsVisible="False" Classes="pill">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="TcuProgramTune_Box" Grid.Column="0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="TcuProgramTuneRemove" Grid.Column="1" Content="&#x2715;" Classes="key"
                            Padding="6,1" Margin="4,0,0,0" Click="TcuProgramTuneRemove_Click"
                            ToolTip.Tip="Remove the calibration. If the program is of another release than the transmission, a calibration is required and Write Program will ask for one."/>
                  </Grid>
                </Border>
                <Button x:Name="WriteTcuProgram" Content="Write Program" Classes="danger" HorizontalAlignment="Stretch"
                        Click="WriteTcuProgram_Click" IsEnabled="False" IsVisible="False"
                        ToolTip.Tip="Erase the four program sectors (0x0A0000-0x0DFFFF) and reprogram them, then write the calibration shown above if there is one. Not recoverable over the diagnostic port if it fails."/>
                <Button x:Name="InstallReadPatch" Content="Install Read Patch" HorizontalAlignment="Stretch"
                        Click="InstallReadPatch_Click" IsEnabled="False" IsVisible="False"
                        ToolTip.Tip="Write the built-in 7552700 program with the full-read patch. Only for a transmission already on G2210_0090C0; the calibration is not touched."/>
                <CheckBox x:Name="TcuFullBin_CheckBox" Content="Full Binary" Click="TcuFullBin_CheckBox_Changed"
                          ToolTip.Tip="Show the program write. The calibration is the everyday write; the program is only replaced for an update or a patch."/>
                <CheckBox x:Name="TcuFastMode" Content="Fast mode" IsChecked="True"
                          ToolTip.Tip="Ask the transmission to talk at 125000 baud instead of 9600. Falls back on its own if the transmission will not."/>
                <TextBlock Text="Take a backup read first and keep the engine off with a charger on."
                           Classes="faint" TextWrapping="Wrap"/>

                <!-- Subcode-8 read. Stock firmware gates 06 to the calibration;
                     a module carrying the patched program answers an extra
                     subcode that reaches any address. -->
                <Separator Margin="0,4,0,0"/>
                <Button x:Name="TestFullRead" Content="Read Full" HorizontalAlignment="Stretch"
                        Click="TestFullRead_Click" IsEnabled="False"
                        ToolTip.Tip="Read the whole 512 KB module image (boot block, calibration, program). Needs the patched program; identify checks for it."/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1" Spacing="5">
            <Button x:Name="CustomOptions" Content="&#x2699;&#xFE0E; Custom Options" HorizontalAlignment="Stretch"
                    Click="CustomOptions_Click"
                    ToolTip.Tip="EWS delete and map switch."/>
            <TextBlock x:Name="CustomOptionsSummary_Box" TextWrapping="Wrap" Classes="faint"/>
          </StackPanel>
          </Grid>
        </Grid>

        <!-- ============ Custom Options ============ -->
        <!-- File preparation and program patches. Nothing here talks to the
             car; the Flashing view stays the one place that writes to the DME. -->
        <ScrollViewer x:Name="CustomOptionsView" IsVisible="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="CustomOptionsBack" Content="&#x2039;  Back" Classes="key"
                      VerticalAlignment="Center" Click="CustomOptionsBack_Click"/>
              <TextBlock Classes="h1" Text="Custom Options" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- EWS delete. Only meaningful for a full-binary program flash: the
                 patch sites live in the program area, not the tune/parameter area. -->
            <Border x:Name="EwsSection" Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="code" Text="EWS DELETE"/>
                <CheckBox x:Name="EwsDelete_CheckBox" Content="EWS Delete" IsEnabled="False"
                          Click="EwsDelete_CheckBox_Changed"
                          ToolTip.Tip="Patch the immobilizer check out of the program before flashing. MS45.1 only."/>
                <TextBlock x:Name="EwsDeleteReason_Box" TextWrapping="Wrap" Classes="faint"/>
              </StackPanel>
            </Border>

            <Border x:Name="MapSwitchSection" Classes="section">
              <StackPanel Spacing="10">
                <TextBlock Classes="code" Text="MAP SWITCH"/>
                <TextBlock TextWrapping="Wrap" Classes="dim"
                           Text="Two full tunes in one MS45.1 program (0044570LO02S). The DSC button switches at any time, even while driving (presses in the first 10 s after ignition-on are ignored); the pedals only with the engine stopped. Engine off, the tach shows 1000 rpm for map 1 or 2000 rpm for map 2, also for 3 s at ignition-on; engine running, the check-engine lamp blinks once for map 1, twice for map 2."/>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="dim" Text="Trigger" VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="MapSwitchTriggerDsc" GroupName="MapSwitchTrigger" IsChecked="True"
                                 Content="DSC button" Click="MapSwitchTrigger_Click"
                                 ToolTip.Tip="Short presses of the DSC button (the DTC on/off ones, not the long hold) within about 2 seconds of each other. DTC ends up as it started."/>
                    <RadioButton x:Name="MapSwitchTriggerPedals" GroupName="MapSwitchTrigger"
                                 Content="Brake + full throttle, 5 s" Click="MapSwitchTrigger_Click"
                                 ToolTip.Tip="Hold the brake and floor the throttle for 5 seconds."/>
                  </StackPanel>

                  <TextBlock x:Name="MapSwitchPressesLabel" Grid.Row="1" Grid.Column="0" Classes="dim" Text="Presses" VerticalAlignment="Center"/>
                  <StackPanel x:Name="MapSwitchPressesRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="MapSwitchPresses4" GroupName="MapSwitchPresses" IsChecked="True"
                                 Content="4" Click="MapSwitchTrigger_Click"/>
                    <RadioButton x:Name="MapSwitchPresses2" GroupName="MapSwitchPresses"
                                 Content="2" Click="MapSwitchTrigger_Click"
                                 ToolTip.Tip="Quicker, but two quick presses with the engine stopped is easier to do by accident."/>
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                  <Button x:Name="MapSwitchLoadFlash" Grid.Row="0" Grid.Column="0" Content="External Flash / .0pa..."
                          HorizontalAlignment="Stretch" Click="MapSwitchLoadFlash_Click"
                          ToolTip.Tip="The 1 MB external flash image to build from, or a BMW .0PA program file, which fills in the MPC as well."/>
                  <TextBlock x:Name="MapSwitchFlash_Box" Grid.Row="0" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>

                  <Button x:Name="MapSwitchLoadMpc" Grid.Row="1" Grid.Column="0" Content="MPC Flash / .0pa..."
                          HorizontalAlignment="Stretch" Click="MapSwitchLoadMpc_Click"
                          ToolTip.Tip="The 448 KB internal flash image that belongs to the external flash, or a BMW .0PA program file to take it from."/>
                  <TextBlock x:Name="MapSwitchMpc_Box" Grid.Row="1" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>

                  <Button x:Name="MapSwitchLoadMap1" Grid.Row="2" Grid.Column="0" Content="Map 1 Tune / .0da..."
                          HorizontalAlignment="Stretch" Click="MapSwitchLoadMap1_Click"
                          ToolTip.Tip="Optional. A tune partial, a full image, or a BMW .0DA data file. Left empty, the tune inside the external flash is kept."/>
                  <TextBlock x:Name="MapSwitchMap1_Box" Grid.Row="2" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>

                  <Button x:Name="MapSwitchLoadMap2" Grid.Row="3" Grid.Column="0" Content="Map 2 Tune / .0da..."
                          HorizontalAlignment="Stretch" Click="MapSwitchLoadMap2_Click"
                          ToolTip.Tip="Optional. A tune partial, a full image, or a BMW .0DA data file. Left empty, map 2 is a copy of map 1."/>
                  <TextBlock x:Name="MapSwitchMap2_Box" Grid.Row="3" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                </Grid>

                <Separator/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="MapSwitchBuild" Content="Build" Classes="primary" Click="MapSwitchBuild_Click" IsEnabled="False"/>
                  <Button x:Name="MapSwitchSave" Content="Save Files..." Click="MapSwitchSave_Click" IsEnabled="False"
                          ToolTip.Tip="Save the built external flash and MPC flash, checksummed and signed."/>
                  <Button x:Name="MapSwitchSend" Content="Load for Flashing" Click="MapSwitchSend_Click" IsEnabled="False"
                          ToolTip.Tip="Load the built pair as the full binary to flash, ready for Flash Program."/>
                </StackPanel>

                <TextBlock x:Name="MapSwitchReport_Box" TextWrapping="Wrap" Classes="mono"
                           Text="Choose an external flash and its MPC flash."/>

                <TextBlock TextWrapping="Wrap" Classes="faint"
                           Text="Map 2 is stored inside the program area, so changing it needs a full program flash; map 1 can still be written with Flash Tune."/>
              </StackPanel>
            </Border>

            <!-- Transmission options. Shown in place of the DME sections when
                 the TCU is the selected module. -->
            <Border x:Name="TcuUpshiftSection" Classes="section" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock Classes="code" Text="REMOVE AUTO UPSHIFT"/>
                <TextBlock TextWrapping="Wrap" Classes="dim"
                           Text="Raises every upshift point out of reach, so the gearbox holds whichever gear is selected and never changes up on its own. The engine runs to the limiter instead of shifting, and the car will not move off again until you shift by hand. Applied to the loaded calibration before it is written; the file on disk is not changed."/>
                <CheckBox x:Name="NoUpshift_CheckBox" Content="Remove auto upshift" IsEnabled="False"
                          Click="NoUpshift_CheckBox_Changed"/>
                <TextBlock x:Name="NoUpshiftReason_Box" TextWrapping="Wrap" Classes="faint"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        </Panel>
      </TabItem>

      <!-- ============ Fault Codes ============ -->
      <!-- Disabled until the DME is identified, since every action here needs a
           resolved SGBD and a live connection. -->
      <TabItem x:Name="FaultsTab" Header="Fault Codes" IsEnabled="False">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <TextBlock Classes="dim" Text="Module" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModuleSelect" Width="170"
                      SelectionChanged="ModuleSelect_Changed">
              <ComboBoxItem Content="DME (engine)"/>
              <ComboBoxItem Content="TCU (transmission)"/>
            </ComboBox>
            <Button x:Name="ReadFaults"   Content="Read Fault Codes" Classes="primary" Click="ReadFaults_Click"/>
            <Button x:Name="ClearFaults"  Content="Clear Fault Codes" Classes="danger" Click="ClearFaults_Click"/>
            <Button x:Name="ExportFaults" Content="Export CSV"        Click="ExportFaults_Click" IsEnabled="False"/>
            <TextBlock x:Name="faultCount_Box" Classes="mono dim" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <DataGrid x:Name="FaultGrid" Grid.Row="1"
                    x:DataType="local:MainWindow+FaultRow"
                    IsReadOnly="True" GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column" CanUserResizeColumns="True"
                    DoubleTapped="FaultGrid_DoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Code"   Binding="{Binding Code}"  Width="*"/>
              <DataGridTextColumn Header="P-Code" Binding="{Binding PCode}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                     Margin="0,0,0,6" Classes="faint"
                     Text="Double-click a fault for full details"/>
        </Grid>
      </TabItem>

      <!-- ============ Live Log ============ -->
      <!-- Polls the chosen modules over the K-line and writes every sample
           to a CSV in the app's folder. For intermittent faults: three
           modules see the ignition switch from different places. -->
      <TabItem x:Name="LiveTab" Header="Live Log" IsEnabled="False">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <CheckBox x:Name="LiveDme_CheckBox" Content="DME" IsChecked="True"
                      ToolTip.Tip="rpm, battery voltage at the DME, its terminal-15 input, temperatures, pedal, air mass, speed"/>
            <CheckBox x:Name="LiveGm5_CheckBox" Content="Body module (GM5)" IsChecked="True"
                      ToolTip.Tip="terminals R / 15 / 50 / 58 as the body module sees them, straight off the ignition switch, and its two terminal-30 supply voltages"/>
            <CheckBox x:Name="LiveKombi_CheckBox" Content="Cluster" IsChecked="False"
                      ToolTip.Tip="terminals 15 / R / 30 / 50 at the instrument cluster"/>
            <Button x:Name="LiveStart" Content="Start" Classes="primary" Click="LiveStart_Click"/>
            <Button x:Name="LiveShowFolder" Content="Show Files" Click="LiveShowFolder_Click"
                    ToolTip.Tip="Open the folder with the CSV logs."/>
          </StackPanel>
          <Border Grid.Row="1" Classes="section" Margin="0,0,0,8">
            <TextBlock x:Name="LiveSummary" Classes="mono" TextWrapping="Wrap" Text="not running"/>
          </Border>
          <Border Grid.Row="2" Classes="log">
            <ScrollViewer>
              <TextBox x:Name="LiveEvents" Classes="mono" IsReadOnly="True" TextWrapping="Wrap"
                       AcceptsReturn="True" BorderThickness="0" Background="Transparent"/>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- ============ History ============ -->
      <!-- Every logged session, kept on this machine only (history.jsonl next
           to settings.json). Nothing here talks to the car or the network. -->
      <TabItem x:Name="HistoryTab" Header="History">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button x:Name="HistoryOpenLog" Content="Open Log" Click="HistoryOpenLog_Click" IsEnabled="False"
                    ToolTip.Tip="Open the selected session's telegram log."/>
            <Button x:Name="HistoryOpenFiles" Content="Open Files" Click="HistoryOpenFiles_Click" IsEnabled="False"
                    ToolTip.Tip="Open the folder with the copies of the images the selected session wrote."/>
            <Button x:Name="HistoryShowFolder" Content="Show Files" Click="HistoryShowFolder_Click"
                    ToolTip.Tip="Open the folder that holds the history and the logs."/>
            <Button x:Name="HistoryClear" Content="Clear History" Classes="danger" Click="HistoryClear_Click"/>
            <TextBlock x:Name="HistoryCount_Box" Classes="mono dim" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <DataGrid x:Name="HistoryGrid" Grid.Row="1"
                    x:DataType="local:MainWindow+HistoryRow"
                    IsReadOnly="True" GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column" CanUserResizeColumns="True"
                    SelectionChanged="HistoryGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date"      Binding="{Binding Time}"      Width="140"/>
              <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="160"/>
              <DataGridTextColumn Header="Result"    Binding="{Binding Result}"    Width="100"/>
              <DataGridTextColumn Header="Car"       Binding="{Binding Car}"       Width="150"/>
              <DataGridTextColumn Header="Details"   Binding="{Binding Details}"   Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock x:Name="HistoryStatus_Box" Grid.Row="2" Margin="0,8,0,0" Classes="mono dim"
                     TextWrapping="Wrap" Text="Select a session to see how it ended."/>
        </Grid>
      </TabItem>

      <!-- ============ Settings ============ -->
      <TabItem x:Name="SettingsTab" Header="Settings">
        <StackPanel Spacing="12">
          <Border Classes="section">
            <StackPanel Spacing="8">
              <TextBlock Classes="code" Text="SKIN"/>
              <ComboBox x:Name="ThemeSelect" MinWidth="180" HorizontalAlignment="Left" SelectionChanged="ThemeSelect_Changed"
                        ToolTip.Tip="The look, as in BMWeb's Settings."/>
            </StackPanel>
          </Border>

          <Border Classes="section">
            <StackPanel Spacing="8">
              <TextBlock Classes="code" Text="FILES"/>
              <CheckBox x:Name="KeepFlashedFiles_CheckBox" Content="Keep a copy of every file written to a module"
                        Click="KeepFlashedFiles_Changed"
                        ToolTip.Tip="Each flash or write session gets a folder with the exact images sent to the module; its History entry opens them."/>
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="Settings, the ECU data, the session logs, the history and those copies all live in the app's folder on this machine. Nothing is sent anywhere."/>
              <Button x:Name="SettingsShowFolder" Content="Show Files" HorizontalAlignment="Left"
                      Click="HistoryShowFolder_Click"/>
            </StackPanel>
          </Border>

          <Border Classes="section">
            <StackPanel Spacing="8">
              <TextBlock Classes="code" Text="PROGRAMMING RECORD"/>
              <CheckBox x:Name="WriteAif_CheckBox" Content="Log every flash in the module (AIF)"
                        Click="WriteAif_Changed"
                        ToolTip.Tip="After a successful flash, append an entry (VIN, date, part numbers, program reference) to the module's programming log, which BMW's tools read as its history."/>
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="A module keeps 14 entries and they cannot be erased. Before a flash the app says how many are left and asks whether to go on. With this off, nothing is written to the log and no question is asked."/>
            </StackPanel>
          </Border>

          <!-- Recovery tools. Shown to everyone; they only need an
               identified DME, not a development build. -->
          <Border Classes="section">
            <StackPanel Spacing="8">
              <TextBlock Classes="code" Text="TESTING ONLY"/>
              <!-- For a flash that stopped after the program was written but
                   before it was verified: the DME then keeps the application
                   from running until both signature checks have passed.
                   Nothing is written. -->
              <Button x:Name="VerifyProgram" Content="Finish Programming" HorizontalAlignment="Left" Click="VerifyProgram_Click" IsEnabled="False"
                      ToolTip.Tip="Runs the DME's program and calibration signature checks and resets it, without writing anything. For a DME left in the bootloader by a flash that failed part-way (programming status stays at 5 until the program is verified)."/>
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="Runs the DME's program and calibration signature checks and resets it; nothing is written. For a DME left in the bootloader by a flash that stopped part-way. Needs an identified DME."/>
            </StackPanel>
          </Border>

          <!-- Only a development build (BMWEB_ENV=development) shows this. -->
          <Border x:Name="DevSection" Classes="section" IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Classes="code" Text="DEVELOPMENT"/>
              <CheckBox x:Name="DevUi_CheckBox" Content="Dev mode UI" Click="DevUi_Changed"
                        ToolTip.Tip="Off shows the app exactly as an end user sees it: Custom Options, Full Binary and the load buttons wait for an identified MS45.1."/>
              <TextBlock Classes="dim" TextWrapping="Wrap"
                         Text="This build runs with BMWEB_ENV=development. Untick to see the app as a release build shows it; the .env file is not changed."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- ============ Emulator ============ -->
      <!-- Boots an emulated control unit (ms45-emu, gs20-emu) on chosen
           files and connects the app to it in place of the cable. Kept last
           so the other screens keep their positions. -->
      <TabItem x:Name="EmulatorTab" Header="Emulator">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Classes="dim" TextWrapping="Wrap"
                       Text="An emulated control unit runs the module's own firmware from the files chosen here and answers on its K line like the real one. While the app is connected to one, every screen works on it instead of the cable, and the bar at the top says so."/>

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="code" Text="THE APP TALKS TO"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton x:Name="EmuConnectCable" GroupName="EmuConnect" IsChecked="True"
                               Content="The cable (a real car)" Click="EmuConnect_Click"/>
                  <RadioButton x:Name="EmuConnectDme" GroupName="EmuConnect" IsEnabled="False"
                               Content="Emulated DME" Click="EmuConnect_Click"/>
                  <RadioButton x:Name="EmuConnectTcu" GroupName="EmuConnect" IsEnabled="False"
                               Content="Emulated TCU" Click="EmuConnect_Click"/>
                </StackPanel>
                <TextBlock x:Name="EmuConnect_Box" Classes="faint" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="code" Text="ENGINE CONTROL UNIT  ·  MS45.1"/>
                <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                  <Button x:Name="EmuDmeFlash" Grid.Row="0" Grid.Column="0" Content="External Flash..."
                          HorizontalAlignment="Stretch" Click="EmuDmeFlash_Click"
                          ToolTip.Tip="A 1 MB external flash read. With the MPC flash below it is a full pair and the emulated DME boots from it. Without one, a program file can be chosen, which is written over this read's boot loader."/>
                  <TextBlock x:Name="EmuDmeFlash_Box" Grid.Row="0" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                  <Button x:Name="EmuDmeFlashClear" Grid.Row="0" Grid.Column="2" Content="Clear"
                          Click="EmuDmeFlashClear_Click"/>
                  <Button x:Name="EmuDmeMpc" Grid.Row="1" Grid.Column="0" Content="MPC Flash..."
                          HorizontalAlignment="Stretch" Click="EmuDmeMpc_Click"
                          ToolTip.Tip="The 448 KB internal flash image that belongs to the external flash. Clear it to boot a program file instead, which brings its own."/>
                  <TextBlock x:Name="EmuDmeMpc_Box" Grid.Row="1" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                  <Button x:Name="EmuDmeMpcClear" Grid.Row="1" Grid.Column="2" Content="Clear"
                          Click="EmuDmeMpcClear_Click"/>
                  <Button x:Name="EmuDmeProgram" Grid.Row="2" Grid.Column="0" Content="Program (.0PA)..."
                          HorizontalAlignment="Stretch" Click="EmuDmeProgram_Click"
                          ToolTip.Tip="One of BMW's MS45.1 program files, as in SP-Daten (MDS451), in place of a full pair. Nothing else is needed: it is put on the boot loader ms45-emu keeps, or on the external flash read's when one is chosen. Greyed out while both the external flash and the MPC flash are chosen."/>
                  <TextBlock x:Name="EmuDmeProgram_Box" Grid.Row="2" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                  <Button x:Name="EmuDmeProgramClear" Grid.Row="2" Grid.Column="2" Content="Clear"
                          Click="EmuDmeProgramClear_Click"/>
                  <Button x:Name="EmuDmeCalibration" Grid.Row="3" Grid.Column="0" Content="Calibration (.0DA)..."
                          HorizontalAlignment="Stretch" Click="EmuDmeCalibration_Click"
                          ToolTip.Tip="Optional, with a program file: one of BMW's calibration files. A program without one keeps the read's calibration when that is made for it, and otherwise gets the first .0DA in its own folder that is. Greyed out while both the external flash and the MPC flash are chosen."/>
                  <TextBlock x:Name="EmuDmeCalibration_Box" Grid.Row="3" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                  <Button x:Name="EmuDmeCalibrationClear" Grid.Row="3" Grid.Column="2" Content="Clear"
                          Click="EmuDmeCalibrationClear_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <CheckBox x:Name="EmuDmeResume" Content="Continue on the last session's flash"
                            ToolTip.Tip="Boot on what the emulated DME's flash held when it was last shut down, for example a flash that was interrupted, instead of the files above."/>
                  <CheckBox x:Name="EmuDmeTurbo" Content="Turbo"
                            ToolTip.Tip="Answer as fast as the emulator can instead of at the K line's pace. Quicker flashes; not for checking timing."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="EmuDmeBoot" Content="Boot" Classes="primary" MinWidth="90" Click="EmuDmeBoot_Click"/>
                  <Button x:Name="EmuDmeStop" Content="Shut Down" MinWidth="90" Click="EmuDmeStop_Click" IsEnabled="False"
                          ToolTip.Tip="Stops the emulator. What its flash and EEPROM hold is kept for Continue."/>
                  <Button x:Name="EmuDmeBmweb" Content="Open in BMWeb" MinWidth="90" Click="EmuDmeBmweb_Click" IsEnabled="False"
                          ToolTip.Tip="BMWeb in the browser with this emulated DME as its cable (its WebSocket on localhost:8767, which the status line shows). One page at a time: a second is refused until the first leaves. Any BMWeb takes it with ?gateway=ws://localhost:8767 on its URL."/>
                  <CheckBox x:Name="EmuDmeIgnition" Content="Ignition" Margin="12,0,0,0" IsEnabled="False"
                            Click="EmuDmeIgnition_Click"
                            ToolTip.Tip="Terminal 15. Off, the program does its after-run and the DME is then without power (a DME in its boot loader is off at once). On again it starts from its reset vector, as after a key cycle in the car."/>
                </StackPanel>
                <TextBlock x:Name="EmuDmeStatus_Box" Classes="mono" TextWrapping="Wrap" Text="not running"/>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="code" Text="TRANSMISSION  ·  GS20"/>
                <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                  <Button x:Name="EmuTcuImage" Grid.Row="0" Grid.Column="0" Content="Image (512 KB)..."
                          HorizontalAlignment="Stretch" Click="EmuTcuImage_Click"
                          ToolTip.Tip="A 512 KB image: a full read, or a file built for writing, which is run on the stock boot block. Clear it to boot a program or calibration file instead."/>
                  <TextBlock x:Name="EmuTcuImage_Box" Grid.Row="0" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                  <Button x:Name="EmuTcuImageClear" Grid.Row="0" Grid.Column="2" Content="Clear"
                          Click="EmuTcuImageClear_Click"/>
                  <Button x:Name="EmuTcuProgram" Grid.Row="1" Grid.Column="0" Content="Program (.0PA)..."
                          HorizontalAlignment="Stretch" Click="EmuTcuProgram_Click"
                          ToolTip.Tip="One of BMW's GS20 program files, as in SP-Daten (GD20), in place of a full image: it is put on the boot block of gs20-emu's stock image. Greyed out while a full image is chosen."/>
                  <TextBlock x:Name="EmuTcuProgram_Box" Grid.Row="1" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                  <Button x:Name="EmuTcuProgramClear" Grid.Row="1" Grid.Column="2" Content="Clear"
                          Click="EmuTcuProgramClear_Click"/>
                  <Button x:Name="EmuTcuCalibration" Grid.Row="2" Grid.Column="0" Content="Calibration (.0DA)..."
                          HorizontalAlignment="Stretch" Click="EmuTcuCalibration_Click"
                          ToolTip.Tip="Optional: one of BMW's calibration files, on gs20-emu's stock image. A program without one keeps the stock calibration when the boot block takes the two together, and otherwise gets the first .0DA in its own folder that it does take. Greyed out while a full image is chosen."/>
                  <TextBlock x:Name="EmuTcuCalibration_Box" Grid.Row="2" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
                  <Button x:Name="EmuTcuCalibrationClear" Grid.Row="2" Grid.Column="2" Content="Clear"
                          Click="EmuTcuCalibrationClear_Click"/>
                </Grid>
                <CheckBox x:Name="EmuTcuResume" Content="Continue on the last session's flash"
                          ToolTip.Tip="Boot on what the emulated transmission's flash held when it was last shut down instead of the file above."/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="EmuTcuBoot" Content="Boot" Classes="primary" MinWidth="90" Click="EmuTcuBoot_Click"/>
                  <Button x:Name="EmuTcuStop" Content="Shut Down" MinWidth="90" Click="EmuTcuStop_Click" IsEnabled="False"
                          ToolTip.Tip="Stops the emulator. A flash a write has changed is kept for Continue."/>
                  <Button x:Name="EmuTcuBmweb" Content="Open in BMWeb" MinWidth="90" Click="EmuTcuBmweb_Click" IsEnabled="False"
                          ToolTip.Tip="BMWeb in the browser with this emulated transmission as its cable (its WebSocket on localhost:8770, which the status line shows). One page at a time. Any BMWeb takes it with ?gateway=ws://localhost:8770 on its URL."/>
                  <CheckBox x:Name="EmuTcuPower" Content="Power (ignition)" Margin="12,0,0,0" IsEnabled="False"
                            Click="EmuTcuPower_Click"
                            ToolTip.Tip="The transmission's supply. Off and on again is a power cycle: RAM cleared, a start from the reset vector on the flash as it was left."/>
                </StackPanel>
                <TextBlock x:Name="EmuTcuStatus_Box" Classes="mono" TextWrapping="Wrap" Text="not running"/>
              </StackPanel>
            </Border>

            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Classes="code" Text="EMULATOR FOLDERS"/>
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="10">
                  <Button x:Name="EmuFolderMs45" Grid.Row="0" Grid.Column="0" Content="ms45-emu..."
                          HorizontalAlignment="Stretch" Click="EmuFolderMs45_Click"
                          ToolTip.Tip="The ms45-emu checkout (the folder with tools/kline.py)."/>
                  <TextBlock x:Name="EmuFolderMs45_Box" Grid.Row="0" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <Button x:Name="EmuFolderGs20" Grid.Row="1" Grid.Column="0" Content="gs20-emu..."
                          HorizontalAlignment="Stretch" Click="EmuFolderGs20_Click"
                          ToolTip.Tip="The gs20-emu checkout (the folder with tools/kline.py)."/>
                  <TextBlock x:Name="EmuFolderGs20_Box" Grid.Row="1" Grid.Column="1" Classes="mono dim"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="log" MinHeight="110" MaxHeight="220">
              <ScrollViewer x:Name="EmuLogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="EmuLog" Classes="mono" TextWrapping="Wrap" LineHeight="18"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- ============ status bar ============ -->
    <Border Grid.Column="1" Grid.Row="2" Classes="bar" BorderThickness="0,1,0,0" Padding="14,9,14,11" Margin="0,12,0,0">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
        <TextBlock x:Name="statusTextBlock" Grid.Row="0" Classes="mono" TextWrapping="Wrap" Text="ready"/>
        <ProgressBar x:Name="ProgressDME" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Height="12"/>
      </Grid>
    </Border>
  </Grid>
</Window>
