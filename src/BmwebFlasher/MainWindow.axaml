<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BmwebFlasher"
        x:Class="BmwebFlasher.MainWindow"
        Width="640" Height="640" MinWidth="620" MinHeight="620"
        Icon="/Assets/icon.ico"
        Title="BMWeb Flasher">
  <!-- The WPF original positioned every control with absolute Margins inside a
       Grid. That does not survive a different text renderer, so the port uses
       real layout containers instead. The tabs share the status bar and
       progress bar at the bottom. -->
  <Grid Margin="0" RowDefinitions="*,Auto,Auto">

    <TabControl Grid.Row="0" Margin="12,8,12,0">

      <!-- ============ Flashing ============ -->
      <TabItem Header="Flashing">
        <!-- Two views share this tab. Custom Options replaces the flashing
             controls rather than getting a tab header of its own, so Flashing
             stays the selected tab while it is open. -->
        <Panel>
        <Grid x:Name="FlashingMainView" Margin="8" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ModuleInfoHeader" Grid.Row="0" Grid.Column="0" Text="Select a control unit above." Margin="0,0,0,8"/>

          <Grid Grid.Row="1" Grid.Column="0"
                ColumnDefinitions="130,*" VerticalAlignment="Top"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="DME Type" Margin="0,3"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="HW Reference" Margin="0,3"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="SW Reference" Margin="0,3"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Program Status" Margin="0,3"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="VIN" Margin="0,3"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Program Ref." Margin="0,3"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Diag. Protocol" Margin="0,3"/>

            <TextBlock x:Name="DMEType_Box"       Grid.Row="0" Grid.Column="1" Margin="0,3"/>
            <TextBlock x:Name="HWRef_Box"         Grid.Row="1" Grid.Column="1" Margin="0,3"/>
            <TextBlock x:Name="SWRef_Box"         Grid.Row="2" Grid.Column="1" Margin="0,3"/>
            <TextBlock x:Name="programStatus_Box" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
            <TextBlock x:Name="VIN_Box"           Grid.Row="4" Grid.Column="1" Margin="0,3"/>
            <TextBlock x:Name="progRef_Box"       Grid.Row="5" Grid.Column="1" Margin="0,3"/>
            <TextBlock x:Name="diagProtocol_Box"  Grid.Row="6" Grid.Column="1" Margin="0,3"/>
          </Grid>

          <!-- Scrolls if the window is ever shorter than the button stack, so
               the last controls (Full Binary / Custom Options) can't be clipped. -->
          <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="210" Spacing="4" HorizontalAlignment="Right">
              <!-- Choose the module first; the DME and TCU controls are shown
                   exclusively so their buttons can never be confused. -->
              <ComboBox x:Name="FlashModuleSelect" HorizontalAlignment="Stretch"
                        PlaceholderText="Select control unit..."
                        SelectionChanged="FlashModuleSelect_Changed">
                <ComboBoxItem Content="DME (engine)"/>
                <ComboBoxItem Content="TCU (transmission)"/>
              </ComboBox>
              <Button x:Name="SetPort"      Content="Set Serial Port"        HorizontalAlignment="Stretch" Click="SetPort_Click"/>
              <Button x:Name="IdentifyDME"  Content="Identify"               HorizontalAlignment="Stretch" Click="IdentifyDME_Click" IsEnabled="False"/>
              <Button x:Name="LoadSGBD"     Content="Load SGBD (.PRG)"       HorizontalAlignment="Stretch" Click="LoadSGBD_Click"/>

              <!-- DME controls -->
              <StackPanel x:Name="DmePanel" Spacing="4">
                <Button x:Name="ReadTune"     Content="Read DME"               HorizontalAlignment="Stretch" Click="ReadTune_Click"     IsEnabled="False"/>
                <!-- Only for a car that identified as carrying the map switch. -->
                <Button x:Name="ReadInstalledMaps" Content="Read Installed Maps" HorizontalAlignment="Stretch" Click="ReadInstalledMaps_Click" IsVisible="False"
                        ToolTip.Tip="Reads map 1 and map 2 from the car and saves each as a tune file."/>
                <Button x:Name="LoadFile"     Content="Load File / .0da"              HorizontalAlignment="Stretch" Click="LoadFile_Click"     IsEnabled="False"/>
                <TextBlock x:Name="LoadFileName_Box" IsVisible="False" FontSize="11" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" Margin="2,-2,0,2"/>
                <!-- Shown when a BMW .0PA / .0DA was loaded in place of a raw
                     binary. It sits under the button it was loaded with,
                     which is greyed out until it is removed. -->
                <Border x:Name="ExchangeFileRow" IsVisible="False"
                        BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Padding="6,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ExchangeFile_Box" Grid.Column="0" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ExchangeFileRemove" Grid.Column="1" Content="&#x2715;"
                            Padding="6,0" Margin="4,0,0,0" Click="ExchangeFileRemove_Click"
                            ToolTip.Tip="Remove the loaded file."/>
                  </Grid>
                </Border>
                <!-- File 2 and Flash Program only mean something for a full
                     binary, so they stay hidden until Full Binary is ticked. -->
                <Button x:Name="LoadFile2"    Content="Load File 2 (MPC Flash)" HorizontalAlignment="Stretch" Click="LoadFile2_Click"    IsEnabled="False" IsVisible="False"/>
                <TextBlock x:Name="LoadFile2Name_Box" IsVisible="False" FontSize="11" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" Margin="2,-2,0,2"/>
                <!-- The .0DA paired with a loaded .0PA, which has no tune of
                     its own. Optional: without it the tune on the car stays. -->
                <Border x:Name="ExchangeTuneRow" IsVisible="False"
                        BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Padding="6,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ExchangeTune_Box" Grid.Column="0" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ExchangeTuneRemove" Grid.Column="1" Content="&#x2715;"
                            Padding="6,0" Margin="4,0,0,0" Click="ExchangeTuneRemove_Click"
                            ToolTip.Tip="Remove the tune. The tune on the car is then left as it is."/>
                  </Grid>
                </Border>
                <Button x:Name="FlashProgram" Content="Flash Program"          HorizontalAlignment="Stretch" Click="FlashProgram_Click" IsEnabled="False" IsVisible="False"/>
                <Button x:Name="FlashDME"     Content="Flash Tune"             HorizontalAlignment="Stretch" Click="FlashData_Click"    IsEnabled="False"/>
                <CheckBox x:Name="FullBin_CheckBox" Content="Full Binary" IsEnabled="False" Click="FullBin_CheckBox_Changed"/>
                <Button x:Name="CustomOptions" Content="&#x2699; Custom Options" HorizontalAlignment="Stretch"
                        Click="CustomOptions_Click"
                        ToolTip.Tip="EWS delete and map switch."/>
                <TextBlock x:Name="CustomOptionsSummary_Box" TextWrapping="Wrap" Opacity="0.6" FontSize="11"/>
              </StackPanel>

              <!-- TCU controls. The GS20 SGBD has no flash jobs, so this is
                   read-only: a calibration dump for backup/inspection. -->
              <StackPanel x:Name="TcuPanel" Spacing="4" IsVisible="False">
                <Button x:Name="ReadTcuCal" Content="Read Calibration" HorizontalAlignment="Stretch"
                        Click="ReadTcuCal_Click" IsEnabled="False"
                        ToolTip.Tip="Dump the transmission calibration (0x090000, 64 KB) to a file."/>
                <Button x:Name="LoadTcuCal" Content="Load Calibration File" HorizontalAlignment="Stretch"
                        Click="LoadTcuCal_Click" IsEnabled="False"
                        ToolTip.Tip="Pick a 64 KB GS20 calibration to write. Its checksum is corrected automatically."/>
                <Button x:Name="WriteTcuCal" Content="Write Calibration" HorizontalAlignment="Stretch"
                        Click="WriteTcuCal_Click" IsEnabled="False"
                        ToolTip.Tip="Erase and reprogram the transmission calibration over raw DS2."/>
                <!-- Program write. The one path here whose failure is not
                     recoverable over the diagnostic port: the DS2 handler
                     lives in the region being rewritten, so a module left
                     half-written stops answering and needs the boot-strap
                     loader. Gated on ident, on the image's software level,
                     and on an explicit acknowledgement. -->
                <Button x:Name="LoadTcuProgram" Content="Load Program File" HorizontalAlignment="Stretch"
                        Click="LoadTcuProgram_Click" IsEnabled="False"
                        ToolTip.Tip="A 256 KB program region, a 512 KB full image, or a BMW .0PA. Its checksum is corrected on the way in."/>
                <Button x:Name="WriteTcuProgram" Content="Write Program" HorizontalAlignment="Stretch"
                        Click="WriteTcuProgram_Click" IsEnabled="False"
                        ToolTip.Tip="Erase the four program sectors (0x0A0000-0x0DFFFF) and reprogram them. Not recoverable over the diagnostic port if it fails."/>
                <Button x:Name="InstallReadPatch" Content="Install Read Patch" HorizontalAlignment="Stretch"
                        Click="InstallReadPatch_Click" IsEnabled="False"
                        ToolTip.Tip="Write the built-in 7552700 program with the full-read patch. Only for a transmission already on G2210_0090C0; the calibration is not touched."/>
                <CheckBox x:Name="NoUpshift_CheckBox" Content="Remove auto upshift" IsEnabled="False"
                          Click="NoUpshift_CheckBox_Changed"
                          ToolTip.Tip="Raise every upshift point out of reach so the gearbox holds the gear you select. Applied to the loaded calibration before it is written."/>
                <CheckBox x:Name="TcuFastMode" Content="Fast mode" IsChecked="True"
                          ToolTip.Tip="Ask the transmission to talk at 125000 baud instead of 9600. Falls back on its own if the transmission will not."/>
                <TextBlock Text="Take a backup read first and keep the engine off with a charger on."
                           Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>

                <!-- Subcode-8 read. Stock firmware gates 06 to the calibration;
                     a module carrying the patched program answers an extra
                     subcode that reaches any address. Kept visible without
                     scrolling: the region picker and its button belong
                     together, and a picker with its button below the fold
                     reads as broken. -->
                <Separator Margin="0,4,0,0"/>
                <!-- Full read through the patched program's subcode-8 read.
                     Enabled only when identify found the module answering
                     that subcode; a stock module never lights it. -->
                <Button x:Name="TestFullRead" Content="Read Full" HorizontalAlignment="Stretch"
                        Click="TestFullRead_Click" IsEnabled="False"
                        ToolTip.Tip="Read the whole 512 KB module image (boot block, calibration, program). Needs the patched program; identify checks for it."/>

              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ============ Custom Options ============ -->
        <!-- File preparation and program patches. Nothing here talks to the
             car; the Flashing view stays the one place that writes to the DME. -->
        <ScrollViewer x:Name="CustomOptionsView" IsVisible="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8" Spacing="10">
            <Grid ColumnDefinitions="Auto,*">
              <Button x:Name="CustomOptionsBack" Grid.Column="0" Content="&#x2190; Back"
                      Click="CustomOptionsBack_Click"/>
              <TextBlock Grid.Column="1" Text="Custom Options" FontWeight="SemiBold" FontSize="15"
                         VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <!-- EWS delete. Only meaningful for a full-binary program flash: the
                 patch sites live in the program area, not the tune/parameter area. -->
            <TextBlock Text="EWS Delete" FontWeight="SemiBold"/>
            <CheckBox x:Name="EwsDelete_CheckBox" Content="EWS Delete" IsEnabled="False"
                      Click="EwsDelete_CheckBox_Changed"
                      ToolTip.Tip="Patch the immobilizer check out of the program before flashing. MS45.1 only."/>
            <TextBlock x:Name="EwsDeleteReason_Box" TextWrapping="Wrap" Opacity="0.6" FontSize="11"/>

            <Separator/>

            <TextBlock Text="Map Switch" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Opacity="0.8"
                         Text="Experimental. Builds an MS45.1 program (0044570LO02S) that holds two tunes. With the engine stopped, hold the brake and full throttle for 5 seconds to switch; the tach then shows 1000 rpm for map 1 or 2000 rpm for map 2. It also shows the active map once, about 6 seconds after ignition-on."/>

              <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                <Button x:Name="MapSwitchLoadFlash" Grid.Row="0" Grid.Column="0" Content="External Flash / .0pa..."
                        HorizontalAlignment="Stretch" Click="MapSwitchLoadFlash_Click"
                        ToolTip.Tip="The 1 MB external flash image to build from, or a BMW .0PA program file, which fills in the MPC as well."/>
                <TextBlock x:Name="MapSwitchFlash_Box" Grid.Row="0" Grid.Column="1"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>

                <Button x:Name="MapSwitchLoadMpc" Grid.Row="1" Grid.Column="0" Content="MPC Flash / .0pa..."
                        HorizontalAlignment="Stretch" Click="MapSwitchLoadMpc_Click"
                        ToolTip.Tip="The 448 KB internal flash image that belongs to the external flash, or a BMW .0PA program file to take it from."/>
                <TextBlock x:Name="MapSwitchMpc_Box" Grid.Row="1" Grid.Column="1"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>

                <Button x:Name="MapSwitchLoadMap1" Grid.Row="2" Grid.Column="0" Content="Map 1 Tune / .0da..."
                        HorizontalAlignment="Stretch" Click="MapSwitchLoadMap1_Click"
                        ToolTip.Tip="Optional. A tune partial, a full image, or a BMW .0DA data file. Left empty, the tune inside the external flash is kept."/>
                <TextBlock x:Name="MapSwitchMap1_Box" Grid.Row="2" Grid.Column="1"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>

                <Button x:Name="MapSwitchLoadMap2" Grid.Row="3" Grid.Column="0" Content="Map 2 Tune / .0da..."
                        HorizontalAlignment="Stretch" Click="MapSwitchLoadMap2_Click"
                        ToolTip.Tip="Optional. A tune partial, a full image, or a BMW .0DA data file. Left empty, map 2 is a copy of map 1."/>
                <TextBlock x:Name="MapSwitchMap2_Box" Grid.Row="3" Grid.Column="1"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="(none)"/>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="MapSwitchUseLoaded" Content="Use Loaded Files" Click="MapSwitchUseLoaded_Click"
                        ToolTip.Tip="Take the external flash and MPC flash already loaded for flashing."/>
                <Button x:Name="MapSwitchClearMaps" Content="Reset Maps" Click="MapSwitchClearMaps_Click"
                        ToolTip.Tip="Forget the chosen map 1 and map 2 tunes."/>
              </StackPanel>

              <Separator/>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="MapSwitchBuild" Content="Build" Click="MapSwitchBuild_Click" IsEnabled="False"/>
                <Button x:Name="MapSwitchSave" Content="Save Files..." Click="MapSwitchSave_Click" IsEnabled="False"
                        ToolTip.Tip="Save the built external flash and MPC flash, checksummed and signed."/>
                <Button x:Name="MapSwitchSend" Content="Load for Flashing" Click="MapSwitchSend_Click" IsEnabled="False"
                        ToolTip.Tip="Load the built pair as the full binary to flash, ready for Flash Program."/>
              </StackPanel>

              <TextBlock x:Name="MapSwitchReport_Box" TextWrapping="Wrap" FontSize="12"
                         Text="Choose an external flash and its MPC flash."/>

              <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="11"
                         Text="Only maps and curves switch. Single values (limits, thresholds, switches) always come from map 1. Map 2 is stored inside the program area, so changing it needs a full program flash; map 1 can still be written with Flash Tune."/>
          </StackPanel>
        </ScrollViewer>
        </Panel>
      </TabItem>

      <!-- ============ Fault Codes ============ -->
      <!-- Disabled until the DME is identified, since every action here needs a
           resolved SGBD and a live connection. -->
      <TabItem x:Name="FaultsTab" Header="Fault Codes" IsEnabled="False">
        <Grid Margin="8" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Module:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModuleSelect" Width="150"
                      SelectionChanged="ModuleSelect_Changed">
              <ComboBoxItem Content="DME (engine)"/>
              <ComboBoxItem Content="TCU (transmission)"/>
            </ComboBox>
            <Button x:Name="ReadFaults"   Content="Read Fault Codes"  Click="ReadFaults_Click"/>
            <Button x:Name="ClearFaults"  Content="Clear Fault Codes" Click="ClearFaults_Click"/>
            <Button x:Name="ExportFaults" Content="Export CSV"        Click="ExportFaults_Click" IsEnabled="False"/>
            <TextBlock x:Name="faultCount_Box" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <DataGrid x:Name="FaultGrid" Grid.Row="1"
                    x:DataType="local:MainWindow+FaultRow"
                    IsReadOnly="True" GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column" CanUserResizeColumns="True"
                    DoubleTapped="FaultGrid_DoubleTapped">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Code"   Binding="{Binding Code}"  Width="*"/>
              <DataGridTextColumn Header="P-Code" Binding="{Binding PCode}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                     Margin="0,0,0,6" Opacity="0.6" FontSize="12"
                     Text="Double-click a fault for full details"/>
        </Grid>
      </TabItem>

    </TabControl>

    <TextBlock x:Name="statusTextBlock" Grid.Row="1"
               Margin="20,10,20,6" TextWrapping="Wrap"/>

    <ProgressBar x:Name="ProgressDME" Grid.Row="2"
                 Margin="20,0,20,16" Minimum="0" Maximum="100" Value="0" Height="24"/>
  </Grid>
</Window>
