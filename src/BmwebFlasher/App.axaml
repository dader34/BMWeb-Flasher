<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BmwebFlasher.App"
             RequestedThemeVariant="Dark">
    <!-- The variant follows the chosen skin (Skins.Apply): dark for
         Brackets, light for Brushed Metal. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://BmwebFlasher/Styles/Flasher.axaml" />
    </Application.Styles>
</Application>
