<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>BmwebFlasher.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the patch logic directly rather than referencing the Avalonia app,
         so the tests stay headless and do not drag in a UI toolkit. -->
    <Compile Include="..\..\src\BmwebFlasher\EwsDelete.cs" Link="EwsDelete.cs" />
    <Compile Include="..\..\src\BmwebFlasher\Gs20Checksum.cs" Link="Gs20Checksum.cs" />
    <Compile Include="..\..\src\BmwebFlasher\Ds2Telegram.cs" Link="Ds2Telegram.cs" />
    <Compile Include="..\..\src\BmwebFlasher\Gs20CalWriter.cs" Link="Gs20CalWriter.cs" />
  </ItemGroup>

</Project>
